/* Full edit shell - mirrors the standalone HTML glass overlay system. */

.edit-shell {
    flex-grow: 1;
}

.done-button {
    position: absolute;
    top: 87px;
    left: 24px;
    height: 70px;
    min-width: 110px;
    padding-left: 24px;
    padding-right: 26px;
    border-radius: 14px;
    border-width: 0;
    background-color: rgb(255, 255, 255);
    color: rgb(17, 17, 17);
    font-size: 30px;
    -unity-font-style: bold;
}

.context-panel {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 160px;
    min-height: 340px;
    max-height: 720px;
    background-color: rgba(10, 12, 15, 0.93);
    border-radius: 26px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-top: 30px;
    padding-bottom: 28px;
    padding-left: 30px;
    padding-right: 30px;
    color: rgb(255, 255, 255);
}

.panel-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 22px;
}

.header-icon {
    width: 65px;
    height: 65px;
    border-radius: 16px;
    background-color: rgba(45, 127, 249, 0.16);
    align-items: center;
    justify-content: center;
    margin-right: 18px;
}

.header-icon-label {
    color: rgb(45, 127, 249);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.header-copy {
    flex-grow: 1;
}

.header-title {
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-font-style: bold;
    margin-bottom: 1px;
}

.header-hint {
    color: rgba(255, 255, 255, 0.55);
    font-size: 26px;
}

.header-right {
    align-items: flex-end;
}

.mode-panel {
    display: none;
}

.mode-panel.is-visible {
    display: flex;
}

.control-row {
    margin-bottom: 22px;
}

.control-row--last {
    margin-bottom: 0;
}

.row-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.control-label {
    color: rgba(255, 255, 255, 0.62);
    font-size: 34px;
}

.value-label {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
}

.slider-line {
    flex-direction: row;
    align-items: center;
}

.round-button {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.10);
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-font-style: bold;
}

.metric-slider,
.color-slider {
    flex-grow: 1;
    height: 64px;
    margin-left: 18px;
    margin-right: 18px;
}

.metric-slider .unity-base-slider__input,
.color-slider .unity-base-slider__input,
.metric-slider .unity-base-slider__drag-container,
.color-slider .unity-base-slider__drag-container {
    height: 100%;
}

.metric-slider .unity-base-slider__dragger,
.color-slider .unity-base-slider__dragger {
    width: 50px;
    height: 50px;
    border-radius: 25px;
    top: 50%;
    margin-top: -25px;
    background-color: rgb(45, 127, 249);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.metric-slider .unity-base-slider__tracker,
.color-slider .unity-base-slider__tracker {
    height: 12px;
    border-radius: 6px;
    top: 50%;
    margin-top: -6px;
    background-color: rgba(255, 255, 255, 0.15);
}

.move-pad {
    width: 324px;
    align-self: center;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.pad-button,
.pad-spacer,
.pad-center {
    width: 96px;
    height: 96px;
    margin: 6px;
}

.pad-button {
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-font-style: bold;
}

.pad-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.pad-button:active {
    background-color: rgb(45, 127, 249);
    border-color: rgb(45, 127, 249);
}

.pad-center {
    border-radius: 18px;
    background-color: rgba(45, 127, 249, 0.16);
    align-items: center;
    justify-content: center;
}

.pad-center-label {
    color: rgb(45, 127, 249);
    font-size: 19px;
    -unity-font-style: bold;
}

.panel-note {
    color: rgba(255, 255, 255, 0.55);
    font-size: 21px;
    -unity-text-align: middle-center;
    margin-top: 18px;
    white-space: normal;
}

.rotate-main {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.step-button {
    width: 160px;
    height: 70px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
}

.rotate-readout {
    align-items: center;
}

.rotation-value {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.rotation-caption {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.50);
}

.snap-row {
    flex-direction: row;
    justify-content: space-between;
}

.snap-button {
    flex-grow: 1;
    height: 56px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(255, 255, 255);
    font-size: 28px;
}

.snap-button.is-selected,
.segment-button.is-selected,
.category-button.is-selected,
.mode-button.is-selected {
    background-color: rgb(45, 127, 249);
    border-color: rgb(45, 127, 249);
    color: rgb(255, 255, 255);
}

.category-row,
.color-target-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.fill-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.free-label {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
}

.ghost-button {
    height: 46px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
    font-size: 23px;
}

.ghost-button:disabled {
    opacity: 0.35;
}

.worktop-button {
    min-width: 128px;
    margin-right: 8px;
    border-color: rgba(249, 179, 45, 0.45);
    background-color: rgba(249, 179, 45, 0.12);
    color: rgb(249, 179, 45);
}

.worktop-button.is-selecting {
    background-color: rgba(249, 179, 45, 0.24);
}

.mandatory-label {
    display: none;
    margin-bottom: 14px;
    color: rgb(255, 122, 122);
    font-size: 20px;
    white-space: normal;
}

.mandatory-label.is-visible {
    display: flex;
}

.placed-strip {
    display: none;
    min-height: 66px;
    max-height: 88px;
    margin-bottom: 12px;
}

.placed-strip.is-visible {
    display: flex;
}

.placed-button {
    min-height: 54px;
    min-width: 138px;
    margin-right: 8px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(45, 127, 249, 0.16);
    color: rgb(255, 255, 255);
    font-size: 22px;
    white-space: normal;
}

.placed-button:hover,
.placed-button:active {
    border-color: rgba(255, 122, 122, 0.65);
    background-color: rgba(255, 122, 122, 0.16);
}

.filler-chip {
    background-color: rgba(249, 179, 45, 0.18);
    border-color: rgba(249, 179, 45, 0.45);
    -unity-font-style: bold;
}

.insert-marker {
    min-height: 54px;
    min-width: 118px;
    margin-right: 8px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(249, 179, 45, 0.45);
    background-color: rgba(249, 179, 45, 0.10);
    color: rgb(249, 179, 45);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.category-button {
    flex-grow: 1;
    height: 54px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(255, 255, 255);
    font-size: 21px;
    -unity-font-style: bold;
}

.catalog-scroll {
    max-height: 340px;
}

.catalog-scroll .unity-scroller--vertical,
.catalog-scroll .unity-scroller--horizontal,
.placed-strip .unity-scroller--vertical,
.placed-strip .unity-scroller--horizontal {
    display: none;
}

.catalog-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.catalog-button {
    width: 100%;
    min-height: 78px;
    margin-bottom: 8px;
    padding: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(255, 255, 255);
    -unity-text-align: upper-left;
}

.catalog-button:disabled {
    opacity: 0.42;
}

.catalog-card-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.catalog-card-title {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
}

.catalog-card-price {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.catalog-card-size {
    color: rgba(255, 255, 255, 0.78);
    font-size: 18px;
}

.catalog-card-bottom {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
}

.catalog-card-action {
    color: rgb(91, 156, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.texture-hint {
    color: rgba(255, 255, 255, 0.55);
    font-size: 26px;
    margin-bottom: 16px;
    white-space: normal;
}

.texture-swatch {
    width: 31%;
    height: 150px;
    margin-bottom: 14px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-and-crop;
}

.texture-swatch.is-selected {
    border-color: rgb(40, 230, 70);
    border-width: 4px;
}

.segment-button {
    flex-grow: 1;
    height: 56px;
    margin-right: 10px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(255, 255, 255);
    font-size: 21px;
    -unity-font-style: bold;
}

.color-preview {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgb(47, 54, 64);
}

.hex-label {
    color: rgba(255, 255, 255, 0.52);
    font-size: 19px;
    -unity-text-align: middle-right;
}

.mode-bar {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 56px;
    height: 96px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 12, 15, 0.93);
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

.mode-button {
    flex-grow: 1;
    height: 100%;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 16px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.62);
    font-size: 28px;
    -unity-font-style: bold;
}

.variant-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.variant-overlay.is-visible {
    display: flex;
}

.variant-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.40);
}

.variant-sheet {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 160px;
    background-color: rgba(18, 21, 28, 0.86);
    border-radius: 26px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    padding-right: 30px;
}

.variant-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.variant-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.variant-subtitle {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.55);
}

.variant-close {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.10);
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.variant-list {
    flex-direction: row;
}

.variant-button {
    flex-grow: 1;
    min-height: 92px;
    margin-right: 10px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(255, 255, 255);
    font-size: 20px;
    white-space: normal;
}

.variant-button.is-selected {
    border-color: rgb(45, 127, 249);
    background-color: rgba(45, 127, 249, 0.22);
}

.toast-label {
    display: none;
    position: absolute;
    align-self: center;
    top: 52px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0.82);
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
}

.toast-label.is-visible {
    display: flex;
}
