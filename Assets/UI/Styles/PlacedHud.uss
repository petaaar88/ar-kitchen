/* Placed-kitchen HUD - reference glass top toggles and idle bar. */

.hud {
    flex-grow: 1;
    justify-content: space-between;
}

.top-bar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-top: 89px;
    padding-right: 24px;
}

.pill {
    flex-direction: row;
    align-items: center;
    height: 70px;
    margin-left: 20px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 18px;
    padding-right: 20px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(18, 21, 28, 0.60);
}

.pill:hover {
    background-color: rgba(24, 27, 35, 0.82);
}

.pill.is-on {
    background-color: rgb(45, 127, 249);
    border-color: rgb(45, 127, 249);
}

.pill.is-on:hover {
    background-color: rgb(65, 145, 255);
}

.pill-icon {
    font-size: 24px;
    margin-right: 10px;
    color: rgba(255, 255, 255, 0.72);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.pill-text {
    font-size: 29px;
    color: rgba(255, 255, 255, 0.72);
}

.pill.is-on .pill-icon,
.pill.is-on .pill-text {
    color: rgb(255, 255, 255);
}

.bottom-bar {
    flex-direction: row;
    align-items: stretch;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 56px;
}

.info-card {
    flex-grow: 1;
    justify-content: center;
    background-color: rgba(10, 12, 15, 0.93);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 34px;
    padding-right: 34px;
}

.card-title {
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(245, 248, 255);
    margin-bottom: 4px;
}

.card-subtitle {
    font-size: 23px;
    color: rgba(255, 255, 255, 0.62);
}

.card-price {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(90, 200, 120);
    margin-top: 6px;
    display: none;
}

.card-price.has-price {
    display: flex;
}

.action-column {
    flex-direction: column;
    justify-content: space-between;
    margin-left: 18px;
}

.edit-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding-left: 42px;
    padding-right: 42px;
    border-radius: 20px;
    border-width: 0;
    background-color: rgb(45, 127, 249);
    flex-grow: 1;
}

.edit-button:hover {
    background-color: rgb(65, 145, 255);
}

.edit-button:active {
    background-color: rgb(35, 106, 220);
}

.edit-text {
    font-size: 35px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.purchase-button {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0;
    margin-top: 12px;
    padding-left: 28px;
    padding-right: 28px;
    border-radius: 20px;
    border-width: 0;
    background-color: rgb(52, 199, 89);
    flex-grow: 1;
}

.purchase-button.is-visible {
    display: flex;
}

.purchase-button:hover {
    background-color: rgb(72, 219, 109);
}

.purchase-button:active {
    background-color: rgb(40, 167, 70);
}

.purchase-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.congrats-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.congrats-overlay.is-visible {
    display: flex;
}

.congrats-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 10, 0.66);
}

.congrats-card {
    background-color: rgba(14, 17, 23, 0.98);
    border-radius: 34px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding-top: 54px;
    padding-bottom: 46px;
    padding-left: 48px;
    padding-right: 48px;
    align-items: center;
    width: 82%;
    max-width: 840px;
}

.congrats-badge-wrap {
    width: 134px;
    height: 134px;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
}

.congrats-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 134px;
    height: 134px;
    border-radius: 67px;
    border-width: 5px;
    border-color: rgba(46, 204, 113, 0.55);
    background-color: rgba(0, 0, 0, 0);
}

.congrats-badge {
    width: 134px;
    height: 134px;
    border-radius: 67px;
    background-color: rgb(46, 204, 113);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.22);
    align-items: center;
    justify-content: center;
}

.congrats-check {
    font-size: 82px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.confetti-piece {
    position: absolute;
    border-radius: 2px;
}

.congrats-title {
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(247, 250, 255);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.congrats-body {
    font-size: 30px;
    color: rgba(255, 255, 255, 0.72);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 44px;
}

.congrats-close {
    width: 320px;
    height: 84px;
    border-radius: 22px;
    border-width: 0;
    background-color: rgb(46, 204, 113);
    color: rgb(255, 255, 255);
    font-size: 36px;
    -unity-font-style: bold;
}

.congrats-close:hover {
    background-color: rgb(64, 220, 130);
}

.congrats-close:active {
    background-color: rgb(38, 174, 96);
}
